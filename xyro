	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local oc = p.Character
			if oc then
				for _, v in ipairs(oc:GetDescendants()) do

					if v:IsA("BasePart") and v.CanCollide then
						flingCollide[v] = true
						v.CanCollide = false
					end
				end
			end
		end
	end
