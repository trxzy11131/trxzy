function LoadCustomAnims()
    _customAnimsLoaded = true
    local anims = {}
    local okC, rawC = pcall(readfile, fpath("ReanimCustomAnims.json"))
    if okC and type(rawC) == "string" and rawC ~= "" then
        local okJ, decoded = pcall(function() return HttpService:JSONDecode(rawC) end)
        if okJ and type(decoded) == "table" then
            for _, entry in ipairs(decoded) do
                local entryUrl = entry.url
                if not entryUrl and entry.file then
                    local exists = false
                    pcall(function() exists = isfile and isfile(entry.file) end)
                    if exists then
                        entryUrl = entry.file
                    else
                        local okF, fileContent = pcall(readfile, entry.file)
                        if okF and type(fileContent) == "string" and fileContent ~= "" then
                            entryUrl = fileContent
                        end
                    end
                end
                local animEntry = { name = entry.name, url = entryUrl or "", raw = entry.raw ~= false, isJson = entry.isJson }
                if entry.format == 2 and entry.animData then
                    animEntry.format = 2
                    animEntry.animData = entry.animData
                end
                table.insert(anims, animEntry)
            end
        end
    end
    if #anims == 0 then
        local okR, raw = pcall(readfile, "ReanimCustom.lua")
        if okR and type(raw) == "string" and #raw > 20 and raw ~= "return {}" then
            local data = parseLargeCustomFile(raw)
            if #data > 0 then
                anims = data
                task.spawn(function()
                    _customAnimsLoaded = true
                    CustomAnims = anims
                    SaveCustomAnims()
                    pcall(function() writefile("ReanimCustom.lua", "return {}") end)
                end)
            end
        end
    end
    if #anims > 0 then return anims end
    if type(_G._ReanimCustomAnims) == "table" then return _G._ReanimCustomAnims end
    return {}
end

function ScanCustomsFolder()
    if not _listFiles then return 0 end
    local ok, files = pcall(_listFiles, CONFIG.CUSTOMS_FOLDER)
    if not ok or type(files) ~= "table" then return 0 end

    local knownNames, knownPaths = {}, {}
    for _, ca in ipairs(CustomAnims or {}) do
        knownNames[ca.name] = true
        if type(ca.url) == "string" then knownPaths[ca.url] = true end
    end

    local added = 0
    for _, filePath in ipairs(files) do
        if type(filePath) == "string" and not knownPaths[filePath] then
            local ext  = filePath:match("%.(%w+)$") or ""
            local base = filePath:match("([^/\\]+)%.%w+$") or filePath:match("([^/\\]+)$") or filePath
            local cleanName = base

            if not knownNames[cleanName] then
                local isJson = (ext:lower() == "json")
                table.insert(CustomAnims, {
                    name = cleanName,
                    url = filePath,
                    raw = true,
                    isJson = isJson,
                })
                CustomAnimations[cleanName] = filePath
                knownNames[cleanName] = true
                knownPaths[filePath] = true
                added = added + 1
            end
        end
    end
    return added
end
