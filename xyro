        local b = speedKeyWidgets[idx].kbtn
        b.Text = "["..kc.Name.."]"; b.BackgroundColor3 = C.bg3
        b.TextColor3 = C.accent
        if linkRevToNormal and revSpeedKeyWidgets[idx] then
            ReverseSpeedKeybinds[idx].key = kc
