local function permHidePlayer(targetPlayer)
    if not targetPlayer or targetPlayer == plr then return end
    PermHiddenPlayers[targetPlayer.UserId] = true
    pcall(function()
        if targetPlayer.Character then
            for _, part in pairs(targetPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Anchored = true
                    part.CanCollide = false
                    part.Transparency = 1
                    part.CanQuery = false
                    part.CanTouch = false
                elseif part:IsA("Decal") or part:IsA("SurfaceGui") or part:IsA("BillboardGui") then
                    part.Enabled = false
                elseif part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Beam") then
                    part.Enabled = false
                elseif part:IsA("Sound") then
                    part:Stop()
                    part.Volume = 0
                end
            end
            pcall(function() targetPlayer.Character.Parent = nil end)
        end
    end)
    pcall(function() game:GetService("StarterGui"):SetCore("ChatMutePlayer", targetPlayer.Name) end)
    pcall(function() game:GetService("SoundService").LocalMuted[targetPlayer.UserId] = true end)
    Notify("PermHidden: " .. targetPlayer.Name, "Character hidden + muted", 3)
end

local function unpermHidePlayer(targetPlayer)
    if not targetPlayer then return end
    PermHiddenPlayers[targetPlayer.UserId] = nil
    pcall(function()
        if targetPlayer.Character then
            if not targetPlayer.Character.Parent then
                targetPlayer.Character.Parent = workspace
            end
            for _, part in pairs(targetPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Anchored = false
                    part.CanCollide = true
                    part.Transparency = 0
                    part.CanQuery = true
                    part.CanTouch = true
                elseif part:IsA("Decal") or part:IsA("SurfaceGui") or part:IsA("BillboardGui") then
                    part.Enabled = true
                elseif part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Beam") then
                    part.Enabled = true
                elseif part:IsA("Sound") then
                    part.Volume = 1
                end
            end
        end
    end)
    pcall(function() game:GetService("StarterGui"):SetCore("ChatUnmutePlayer", targetPlayer.Name) end)
    pcall(function() game:GetService("SoundService").LocalMuted[targetPlayer.UserId] = nil end)
    Notify("Unhidden: " .. targetPlayer.Name, "Player restored", 2)
end

