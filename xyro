                SpeedKeybinds[j].key = nil
                speedKeyWidgets[j].kbtn.Text = "[+]"
                speedKeyWidgets[j].kbtn.BackgroundColor3 = C.bg2
                speedKeyWidgets[j].kbtn.TextColor3 = C.text3
            end
