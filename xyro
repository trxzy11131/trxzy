-- ⚡ Per-instance color tag cache for instant theme swaps
local _themeTagged = setmetatable({}, {__mode = "k"})

ApplyTheme = function(themeKey, _noSave)
    local theme = Themes[themeKey] or CustomThemes[themeKey]
    if not theme then return false end
    CurrentThemeKey = themeKey
    local remap = {}
    for key, canonColor in pairs(CanonicalColors) do
        local newColor = theme.colors[key]
        if newColor then
            local k = _colorKey(canonColor)
            if k then remap[k] = newColor end
        end
    end
    for k, v in pairs(theme.colors) do C[k] = v end
    local function remapColor(c)
        if typeof(c) ~= "Color3" then return nil end
        local k = _colorKey(c)
        if not k then return nil end
        return remap[k]
    end
    -- ⚡ Tag every Color3 property with its canonical key so subsequent swaps are O(1)
    local function applyToInstance(inst)
        if not inst then return end
        local tag = _themeTagged[inst]
        if tag then
            for prop, key in pairs(tag) do
                local nc = theme.colors[key]
                if nc then pcall(function() inst[prop] = nc end) end
            end
            return
        end
        local newTag = {}
        local function checkProp(prop)
            local ok, val = pcall(function() return inst[prop] end)
            if not ok or typeof(val) ~= "Color3" then return end
            local k = _colorKey(val)
            if not k then return end
            for ck, cv in pairs(CanonicalColors) do
                if _colorKey(cv) == k then
                    newTag[prop] = ck
                    local nc = theme.colors[ck]
                    if nc then pcall(function() inst[prop] = nc end) end
                    break
                end
            end
        end
        pcall(function() if inst.BackgroundColor3 then checkProp("BackgroundColor3") end end)
        pcall(function() if inst.TextColor3 then checkProp("TextColor3") end end)
        pcall(function() if inst.ImageColor3 then checkProp("ImageColor3") end end)
        pcall(function() if inst.PlaceholderColor3 then checkProp("PlaceholderColor3") end end)
        pcall(function() if inst:IsA("UIStroke") then checkProp("Color") end end)
        pcall(function()
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                if inst.TextStrokeColor3 then checkProp("TextStrokeColor3") end
            end
        end)
        if next(newTag) then _themeTagged[inst] = newTag end
    end
    if ScreenGui then
        pcall(function()
            for _, d in ipairs(ScreenGui:GetDescendants()) do applyToInstance(d) end
        end)
    end
    for k, v in pairs(theme.colors) do CanonicalColors[k] = v end
    if not _noSave then
        pcall(function() writefile("ReanimData/ReanimTheme.txt", themeKey) end)
    end
    return true
end

local function SaveCustomThemes()
    pcall(function()
        local serialized = {}
        for k, t in pairs(CustomThemes) do
            local colors = {}
            for ck, cv in pairs(t.colors) do
                colors[ck] = { math.floor(cv.R*255+0.5), math.floor(cv.G*255+0.5), math.floor(cv.B*255+0.5) }
            end
            serialized[k] = { displayName = t.displayName or k, colors = colors }
        end
        writefile("ReanimData/ReanimCustomThemes.json", HttpService:JSONEncode(serialized))
    end)
end

local function LoadCustomThemes()
    local ok, raw = pcall(readfile, "ReanimData/ReanimCustomThemes.json")
    if not ok or type(raw) ~= "string" or raw == "" then return end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(decoded) ~= "table" then return end
    for k, t in pairs(decoded) do
        if type(t) == "table" and type(t.colors) == "table" then
            local colors = {}
            for ck, cv in pairs(t.colors) do
                if type(cv) == "table" and #cv >= 3 then
                    colors[ck] = Color3.fromRGB(cv[1] or 0, cv[2] or 0, cv[3] or 0)
                end
            end
            CustomThemes[k] = { displayName = t.displayName or k, colors = colors }
        end
    end
    _G._HaloCustomThemes = CustomThemes
end

