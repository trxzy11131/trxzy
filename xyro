			spawnedFabs[#spawnedFabs + 1] = child
		end)
	end

	local ok, result, detail = pcall(def.run)

	if conn then
		task.delay(5, function()
			pcall(function()
				conn:Disconnect()
			end)
		end)
	end

	if not ok then
		return false, result
	end

	if result == false then
		return false, detail or "tool failed"
	end

	return true, result
