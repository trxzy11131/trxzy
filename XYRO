        SaveFavoritesOnly()
        if State.currentTab == "Favs" then RebuildVisible() end
    end)
    keyBtn.MouseButton1Click:Connect(function()
        if Keybinds[anim.name] and _G._HaloListeningKeyBtn ~= keyBtn then
            UnbindKey(anim.name, keyBtn)
            refresh()
            return
        end
        if _G._HaloListeningKeyBtn then CancelListening() end
        _G._HaloListeningKeyBtn = keyBtn
        _G._HaloListenTarget = { name=anim.name, url=anim.url, keyBtn=keyBtn }
        keyBtn.Text = "?"; keyBtn.BackgroundColor3 = Color3.fromRGB(220,120,20)
        keyBtn.TextColor3 = Color3.fromRGB(255,255,255)
    end)
    delBtn.MouseButton1Click:Connect(function()
        local isCustomEntry = anim.name:match("^%[Custom%]")
        if not isCustomEntry then
            Notify("Cannot delete preset animations", 2)
            return
        end
        local plain = anim.name:match("^%[Custom%] (.+)$")
        if not plain then return end
        local currentIdx = nil
        for i, v in ipairs(CustomAnims) do
            if v.name == plain then currentIdx = i; break end
        end
        if not currentIdx then return end
        if State.selectedAnim == anim.name then StopAnimation() end
        table.remove(CustomAnims, currentIdx)
        CustomAnimations[plain] = nil
        SaveCustomAnims(); SaveData()
        if UpdateCustomTabCount then UpdateCustomTabCount() end
        if RebuildCustomList then pcall(RebuildCustomList) end
        RebuildVisible()
        Notify("Deleted: " .. plain, 2)
    end)

    return widget
end

