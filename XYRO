acmAddBtn.MouseButton1Click:Connect(function()
    local rawData = _pendingPasteData or acmDataBox.Text
    rawData = rawData and rawData:gsub("^%s+", ""):gsub("%s+$", "") or ""
    if rawData == "" then
        acmStatus.Text = "Please paste keyframe data first."
        acmStatus.TextColor3 = Color3.fromRGB(255,160,80); return
    end
    local capturedName = acmNameBox.Text:match("^%s*(.-)%s*$")
    local capturedRaw  = rawData
    acmStatus.Text = "Validating..."; acmStatus.TextColor3 = Color3.fromRGB(180,180,220)
    acmAddBtn.Active = false
    task.spawn(function()
        local isJson = false
        local firstChar = capturedRaw:match("^%s*(.)")
        isJson = (firstChar == "{" or firstChar == "[")
        if not capturedRaw:find("{", 1, true) then
            acmStatus.Text = "That doesn't look like keyframe data."
            acmStatus.TextColor3 = Color3.fromRGB(255,90,90)
            acmAddBtn.Active = true; return
        end
        local testFn1 = loadstring(capturedRaw)
        local testFn2 = loadstring("return " .. capturedRaw)
        local isValid = false
        if testFn1 then
            local ok, res = pcall(testFn1)
            if ok and type(res) == "table" then isValid = true end
        end
        if not isValid and testFn2 then
            local ok, res = pcall(testFn2)
            if ok and type(res) == "table" then isValid = true end
        end
        if not isValid then
            acmStatus.Text = "Invalid Lua code. Must return a table of keyframes."
            acmStatus.TextColor3 = Color3.fromRGB(255,90,90)
            acmAddBtn.Active = true; return
        end
        if not testFn1 and testFn2 then
            capturedRaw = "return " .. capturedRaw
        end
        local name = capturedName ~= "" and capturedName or ("Custom_" .. tostring(#CustomAnims + 1))
        if #capturedRaw > _SAVE_INLINE_MAX then
            local safeFileName = fpath("custom_" .. name:gsub("[^%w_%-]", "_") .. ".dat")
            pcall(function() writefile(safeFileName, capturedRaw) end)
            table.insert(CustomAnims, { name = name, url = safeFileName, raw = true, isJson = isJson })
            CustomAnimations[name] = safeFileName
        else
            table.insert(CustomAnims, { name = name, url = capturedRaw, raw = true, isJson = isJson })
            CustomAnimations[name] = capturedRaw
        end
        SaveCustomAnims()
        SaveData()
        pcall(function()
            local toSave = {}
            for _, ca in ipairs(CustomAnims) do
                local c = ca.url or ""
                local isOurFile = type(c) == "string" and not c:match("^https?://") and (c:match("%.dat$") ~= nil or c:match("XYRO CUSTOMS") ~= nil)
                if isOurFile then
                    table.insert(toSave, { name = ca.name, file = c, raw = ca.raw ~= false, isJson = ca.isJson or nil })
                elseif type(c) == "string" and #c > _SAVE_INLINE_MAX then
                    local safeFileName = fpath("custom_" .. ca.name:gsub("[^%w_%-]", "_") .. ".dat")
                    pcall(function() writefile(safeFileName, c) end)
                    ca.url = safeFileName
                    CustomAnimations[ca.name] = safeFileName
                    table.insert(toSave, { name = ca.name, file = safeFileName, raw = ca.raw ~= false, isJson = ca.isJson or nil })
                else
                    table.insert(toSave, { name = ca.name, url = c, raw = ca.raw ~= false, isJson = ca.isJson or nil })
                end
            end
            writefile(fpath("ReanimCustomAnims.json"), HttpService:JSONEncode(toSave))
        end)
        local newEntry = CustomAnims[#CustomAnims]
        if newEntry and type(AppendCustomRow) == "function" then AppendCustomRow(newEntry) end
        if UpdateCustomTabCount then UpdateCustomTabCount() end
        Notify("Added: " .. name, 2)
        _pendingPasteData = nil
        acmAddBtn.Active = true
        CloseAddCustomModal()
    end)
end)

