    end
    if _G._HaloListeningKeyBtn then
        if kc == Enum.KeyCode.Escape then CancelListening(); Notify("Keybind cancelled", 1.5); return end
        BindKey(kc); return
    end
    for i = 1, 6 do
        if SpeedKeybinds[i].key == kc then
            ApplySpeed(SpeedKeybinds[i].speed)
