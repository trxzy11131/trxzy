end

local function processCommand(msg)
    if not msg or msg:sub(1, 1) ~= "?" then return end
    local args = {}
    for arg in msg:sub(2):gmatch("%S+") do
        table.insert(args, arg)
    end
    local cmd = args[1] and args[1]:lower() or ""
    if cmd == "rj" then
        Notify("Rejoining server...", 2)
        task.delay(0.5, function()
            local TeleportService = game:GetService("TeleportService")
            pcall(function() TeleportService:Teleport(game.PlaceId, plr) end)
        end)
    elseif cmd == "permhide" and args[2] then
        local target = getPlayerByPartialName(args[2])
        if target then permHidePlayer(target)
        else Notify("PermHide Error", "No player matching '" .. args[2] .. "'", 3) end
    elseif cmd == "unpermhide" and args[2] then
        local target = getPlayerByPartialName(args[2])
        if target then unpermHidePlayer(target)
        else Notify("UnPermHide Error", "No player matching '" .. args[2] .. "'", 3) end
    elseif cmd == "customs" or cmd == "refresh" then
        local n = ScanCustomsFolder()
        pcall(SaveCustomAnims)
        if RebuildCustomList then pcall(RebuildCustomList) end
        if n > 0 then
            Notify("Imported " .. n .. " custom animation" .. (n == 1 and "" or "s"), 2.5)
        else
            Notify("No new customs found", 2)
        end
    end
end

pcall(function()
    local TextChatService = game:GetService("TextChatService")
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        TextChatService.SendingMessage:Connect(function(message)
            if message.Text and message.Text:sub(1, 1) == "?" then
                processCommand(message.Text)
                message.Text = ""
            end
        end)
    end
end)

-- ═══════════════════════════════════════════════════════════════
-- BLACKLIST SYSTEM  (.bl / .unbl  — admin only: larp_139)
-- Blacklist is keyed by Roblox USERNAME (works offline too).
-- ═══════════════════════════════════════════════════════════════
local BlacklistedUsers = _G._HaloBlacklistedUsers or {}
_G._HaloBlacklistedUsers = BlacklistedUsers

pcall(function()
    local ok, raw = pcall(readfile, fpath("ReanimBlacklist.json"))
    if ok and raw and raw ~= "" then
        local decoded = HttpService:JSONDecode(raw)
        if type(decoded) == "table" then
            for k, v in pairs(decoded) do
                BlacklistedUsers[tostring(k):lower()] = v
            end
        end
    end
end)

local function saveBlacklist()
    pcall(function()
        writefile(fpath("ReanimBlacklist.json"), HttpService:JSONEncode(BlacklistedUsers))
    end)
end

local BLACKLIST_ADMIN = "larp_139"

local function isBlacklistAdmin(player)
    if not player then return false end
    return player.Name == BLACKLIST_ADMIN
end

local function tryKickPlayer(targetPlayer, reason)
    if not targetPlayer or targetPlayer == plr then return false end
    local kicked = false
    pcall(function()
        targetPlayer:Kick(reason or "You have been blacklisted.")
        kicked = true
    end)
    if not kicked then
        pcall(function()
            if typeof(getgenv) == "table" and type(getgenv().Kick) == "function" then
                getgenv().Kick(targetPlayer, reason)
                kicked = true
            end
        end)
    end
    if not kicked then
        pcall(function()
            if type(kick) == "function" then
                kick(targetPlayer)
                kicked = true
            end
        end)
    end
    return kicked
end

local function addToBlacklistByName(username)
    if not username or username == "" then return false end
    username = tostring(username)
    if username:lower() == plr.Name:lower() then return false end
    if username:lower() == BLACKLIST_ADMIN:lower() then return false end

    local key = username:lower()
    local displayName = username
    local userId = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == key or p.DisplayName:lower() == key then
            displayName = p.DisplayName
            userId = p.UserId
            break
        end
    end

    BlacklistedUsers[key] = {
        name = username,
        displayName = displayName,
        userId = userId,
        time = os.time(),
        by = BLACKLIST_ADMIN,
    }
    saveBlacklist()

    if userId then
        task.spawn(function()
            task.wait(0.15)
            local target = Players:GetPlayerByUserId(userId)
            if target then
                tryKickPlayer(target, "You have been blacklisted.")
            end
        end)
    end
    return true, displayName
end

local function removeFromBlacklistByName(username)
    if not username or username == "" then return false, nil end
    username = tostring(username):lower()

    if BlacklistedUsers[username] then
        local nm = BlacklistedUsers[username].name or username
        BlacklistedUsers[username] = nil
        saveBlacklist()
        return true, nm
    end

    for key, data in pairs(BlacklistedUsers) do
        if key:find(username, 1, true)
        or (data.name and data.name:lower():find(username, 1, true))
        or (data.displayName and data.displayName:lower():find(username, 1, true)) then
            local nm = data.name or key
            BlacklistedUsers[key] = nil
            saveBlacklist()
            return true, nm
        end
    end
    return false, nil
end

local function isPlayerBlacklisted(player)
    if not player then return false end
    if BlacklistedUsers[player.Name:lower()] then return true end
    for _, data in pairs(BlacklistedUsers) do
        if data.userId and data.userId == player.UserId then
            return true
        end
    end
    return false
end

local function processBlacklistCommand(speaker, msg)
    if not msg or msg:sub(1, 1) ~= "." then return false end
    local lowered = msg:lower()
    local cmd = lowered:match("^%.(%w+)")
    if cmd ~= "bl" and cmd ~= "unbl" then return false end

    local arg = msg:match("^%.%w+%s+(.+)$")
    if arg then arg = arg:gsub("^%s+", ""):gsub("%s+$", "") end

    if not isBlacklistAdmin(speaker) then
        if speaker == plr then
            Notify("Blacklist", "Denied: only " .. BLACKLIST_ADMIN .. " can use .bl/.unbl", 3)
        end
        return true
    end

    if cmd == "bl" then
        if not arg or arg == "" then
            Notify("Blacklist", "Usage: .bl <roblox_username>", 2)
            return true
        end
        local ok, dn = addToBlacklistByName(arg)
        if ok then
            Notify("Blacklisted: " .. dn, 2)
        else
            Notify("Blacklist", "Cannot blacklist that name", 2)
        end

    elseif cmd == "unbl" then
        if not arg or arg == "" then
            Notify("Blacklist", "Usage: .unbl <roblox_username>", 2)
            return true
        end
        local ok, nm = removeFromBlacklistByName(arg)
        if ok then
            Notify("Unblacklisted: " .. nm, 2)
        else
            Notify("Blacklist", "Not found in blacklist: " .. arg, 2)
        end
    end
    return true
end

task.spawn(function()
    while true do
        task.wait(1.5)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= plr and isPlayerBlacklisted(p) then
                tryKickPlayer(p, "You are blacklisted.")
            end
        end
    end
end)

Players.PlayerAdded:Connect(function(p)
    task.wait(0.5)
    if p ~= plr and isPlayerBlacklisted(p) then
        tryKickPlayer(p, "You are blacklisted.")
    end
end)

local _hasTCS = false
pcall(function()
    local tcs = game:GetService("TextChatService")
    _hasTCS = (tcs.ChatVersion == Enum.ChatVersion.TextChatService)
end)

if _hasTCS then
    pcall(function()
        local TextChatService = game:GetService("TextChatService")
        TextChatService.MessageReceived:Connect(function(message)
            if not message or not message.Text then return end
            if message.Text:sub(1, 1) ~= "." then return end
            local speaker = message.TextSource
                and Players:GetPlayerByUserId(message.TextSource.UserId)
            if speaker then
                processBlacklistCommand(speaker, message.Text)
            end
        end)
    end)
else
    local function hookChatted(p)
        if p and not p:GetAttribute("_HaloBlHooked") then
            p:SetAttribute("_HaloBlHooked", true)
            p.Chatted:Connect(function(msg)
                processBlacklistCommand(p, msg)
            end)
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do hookChatted(p) end
    Players.PlayerAdded:Connect(hookChatted)
end

_G._HaloBlacklistGet    = function() return BlacklistedUsers end
_G._HaloBlacklistAdd    = function(username) return addToBlacklistByName(username) end
_G._HaloBlacklistRemove = function(username) return removeFromBlacklistByName(username) end
_G._HaloBlacklistIsPlayerBlacklisted = isPlayerBlacklisted
_G._HaloBlacklistAdmin  = BLACKLIST_ADMIN

