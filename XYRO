local function _colorKey(c)
    if typeof(c) ~= "Color3" then return nil end
    return string.format("%d_%d_%d",
        math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

ApplyTheme = function(themeKey, _noSave)
    local theme = Themes[themeKey] or CustomThemes[themeKey]
    if not theme then return false end
    CurrentThemeKey = themeKey
    local remap = {}
    for key, canonColor in pairs(CanonicalColors) do
        local newColor = theme.colors[key]
        if newColor then
            local k = _colorKey(canonColor)
            if k then remap[k] = newColor end
        end
    end
    for k, v in pairs(theme.colors) do C[k] = v end
    local function remapColor(c)
        if typeof(c) ~= "Color3" then return nil end
        return remap[_colorKey(c)]
    end
    local function applyToInstance(inst)
        if not inst then return end
        pcall(function() local nc = remapColor(inst.BackgroundColor3); if nc then inst.BackgroundColor3 = nc end end)
        pcall(function() local nc = remapColor(inst.TextColor3); if nc then inst.TextColor3 = nc end end)
        pcall(function() local nc = remapColor(inst.ImageColor3); if nc then inst.ImageColor3 = nc end end)
        pcall(function() local nc = remapColor(inst.PlaceholderColor3); if nc then inst.PlaceholderColor3 = nc end end)
        pcall(function() if inst:IsA("UIStroke") then local nc = remapColor(inst.Color); if nc then inst.Color = nc end end end)
        pcall(function()
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                local nc = remapColor(inst.TextStrokeColor3); if nc then inst.TextStrokeColor3 = nc end
            end
        end)
    end
    if ScreenGui then
        pcall(function()
            applyToInstance(ScreenGui)
            for _, d in ipairs(ScreenGui:GetDescendants()) do applyToInstance(d) end
        end)
    end
    for k, v in pairs(theme.colors) do CanonicalColors[k] = v end
    if not _noSave then
        pcall(function() writefile("ReanimData/ReanimTheme.txt", themeKey) end)
    end
    return true
end

